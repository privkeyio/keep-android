    <string name="main_pending_dkg_recover_unavailable">Couldn\'t access the secure vault to recover this share.</string>
    <string name="main_pending_dkg_unreadable_title">Pending Share Unreadable</string>
    <string name="main_pending_dkg_unreadable_text">A completed signing group share is pending, but its record can\'t be read right now. Creating a new group stays blocked until it is recovered or discarded.</string>
    <string name="main_pending_dkg_retry">Retry</string>
    <string name="main_pending_dkg_later">Later</string>
    <string name="share_unreadable_title">Unreadable account</string>
    <string name="share_unreadable_text">This device\'s secure storage could not read the share of each account listed below. Those accounts can\'t sign, and backups are refused until this is resolved. Your other accounts keep working. A system update can sometimes fix this, so keep the app installed.</string>
    <string name="share_unreadable_retry">Try again</string>
    <string name="share_unreadable_retry_first">Try again first, and restart the device if it still fails. An account that still can\'t be read after that can be set aside.</string>
    <string name="share_unreadable_still">Still unreadable.</string>
    <string name="share_unreadable_readable_again">The account can be read again.</string>
    <string name="share_unreadable_remove">Set aside</string>
    <string name="share_unreadable_keep">Keep it</string>
    <string name="share_unreadable_remove_title">Set this account aside?</string>
    <string name="share_unreadable_remove_text">Keep will stop using %1$s on this device. Nothing is deleted: its encrypted share stays here and you can put it back later. Keep sets it aside only after checking that its key can\'t be decrypted into a usable share.</string>
    <string name="share_unreadable_remove_auth_title">Set aside an unreadable account</string>
    <string name="share_unreadable_remove_auth_subtitle">Confirm it is you before changing this account</string>
    <string name="share_unreadable_removed_title">Account discarded</string>
    <string name="share_unreadable_removed_text">To use this account again, restore it from a backup or import its share.</string>
    <string name="share_unreadable_restore">Restore from backup</string>
    <string name="share_unreadable_import">Import</string>
    <string name="share_unreadable_done">Done</string>
    <string name="share_unreadable_remove_failed">Could not set the account aside.</string>
    <string name="share_unreadable_set_aside">Account set aside. You can put it back from the list of set-aside accounts.</string>
    <string name="share_unreadable_recoverable">This account\'s key still decrypts, so it was kept. Try again, or restart the device.</string>
    <string name="share_unreadable_unverified">Couldn\'t confirm that the key is lost, so nothing changed. Authenticate and try again.</string>
    <string name="share_unreadable_absent">This account is no longer stored on this device.</string>
    <string name="share_unreadable_registry_unavailable">The list of accounts can\'t be read right now, so nothing changed.</string>
    <string name="share_set_aside_title">Set-aside accounts</string>
    <string name="share_set_aside_text">Keep is not using these accounts on this device. Put one back to try it again. Discard one only to restore or import that account fresh.</string>
    <string name="share_set_aside_restore">Put back</string>
    <string name="share_set_aside_restored">Account put back.</string>
    <string name="share_set_aside_restore_failed">Could not put the account back.</string>
    <string name="share_set_aside_discard">Discard</string>
    <string name="share_set_aside_discard_title">Discard this account\'s key?</string>
    <string name="share_set_aside_discard_text">This permanently destroys the share of %1$s on this device. Do this only if you have a backup or the share to import, or enough other shares of the group. Keep checks first that the key really can\'t be decrypted.</string>
    <string name="share_set_aside_discard_confirm">Discard for good</string>
    <string name="share_set_aside_discard_auth_title">Discard an account\'s key</string>
    <string name="share_set_aside_discard_readable">This account\'s key decrypts again, so it was not discarded. Put it back instead.</string>
    <string name="share_set_aside_discard_failed">Could not discard the account. Authenticate and try again.</string>
    <string name="share_set_aside_unreadable">The set-aside accounts can\'t be read right now.</string>
    <string name="share_store_unavailable_title">Your accounts can\'t be read</string>
    <string name="share_store_unavailable_text">This device\'s secure storage could not read the list of stored accounts, so Keep can\'t show or change your accounts until it can. Nothing has been deleted. Try again, or restart the device. A system update can sometimes fix this, so keep the app installed.</string>
